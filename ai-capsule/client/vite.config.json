import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';

// During local dev, Vite runs on its own port (5173) and Express runs
// on 5000. This proxy forwards /api calls to Express so cookies + fetch
// behave the same as production (where Express serves the built React
// app directly, same-origin).
export default defineConfig({
  plugins: [react()],
  server: {
    proxy: {
      '/api': {
        target: 'http://localhost:5000',
        changeOrigin: true,
      },
    },
  },
  build: {
    outDir: 'dist',
  },
});